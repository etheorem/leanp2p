import Tests.Support

/-!
# Vector provenance suite

The corpus under `Tests/vectors` is committed generated output
(ARCHITECTURE §3.8: generated tables are committed source). This suite
pins each file's provenance and spot-checks the data payload of three
files, one per area, so an edit that breaks either fails `lake test`
(ARCHITECTURE §6, verification layer 2). Byte-exactness against
regeneration is a stronger fact than this suite pins. The CI
provenance step checks it.

Most files were generated by `scripts/extract-vectors.py` from the
sources pinned in `VECTORS.lock`; four files were captured from a live
go-libp2p host by `scripts/capture-vectors.go`, also against the pinned
commit. Every file records its provenance in a top-level `_provenance`
object. The records come in three kinds: an extraction record carries
`repo`, `commit`, usually `path` (`protobuf-messages.json` is the one
exception), and `extractedBy`; a capture record adds `capturedBy` and
names `scripts/capture-vectors.go` in `extractedBy`; the RFC vectors
are embedded in the extractor itself, and their `extractedBy` says so
(`commit` stays out). The suite pins what every kind shares: `repo`,
`upstreamTest`, and `extractedBy` as strings, where `extractedBy`
names a tool under `scripts/`. The kind-specific fields (`commit`,
`path`) vary across the corpus, so the suite leaves them to the suites
that read them.

Regenerating the corpus needs the `vendor/` copies of the pinned
sources. They sit in the tree, and the CI provenance step reruns
`scripts/extract-vectors.py` and diffs `Tests/vectors` on every run.
-/

open Lean (Json)

namespace Tests

/-- True when `j` carries the `_provenance` object that every family
writes: `repo`, `upstreamTest`, and `extractedBy` as strings, with
`extractedBy` naming a tool under `scripts/`. The accessors throw on a
missing or mistyped field, so this catches the throw and answers
`false`; a file without provenance fails its own check, and the run
keeps counting the rest of the corpus. -/
private def hasProvenance (file : String) (j : Json) : IO Bool :=
  try
    let prov ← jObj file j "_provenance"
    let _ ← jStr file prov "repo"
    let _ ← jStr file prov "upstreamTest"
    let extractedBy ← jStr file prov "extractedBy"
    -- `String.contains` takes a `Char`, so a substring test goes through
    -- `splitOn`: two or more pieces mean the separator occurred.
    pure ((extractedBy.splitOn "scripts/").length ≥ 2)
  catch e =>
    -- The accessor's message names the file and the missing field; the
    -- check name alone would not.
    IO.eprintln s!"provenance: {e}"
    pure false

/-- True when `k` names a string field that is present and nonempty;
`false` on a missing or mistyped field, with a silent catch: the check
name already names the file and the field. -/
private def nonemptyStr (file : String) (j : Json) (k : String) : IO Bool :=
  try
    return !(← jStr file j k).isEmpty
  catch _ =>
    pure false

/-- True when `k` names an array field that is present and nonempty;
`false` on a missing or mistyped field. -/
private def nonemptyArr (file : String) (j : Json) (k : String) : IO Bool :=
  try
    return !(← jArr file j k).isEmpty
  catch _ =>
    pure false

def Vectors.run (r : Runner) : IO Unit := do
  r.section "vectors" "(vector provenance; every file of Tests/vectors)"

  -- The whole corpus: every `.json` file of the vector directory. The
  -- directory is flat (the corpus has no subdirectories), and the names
  -- are sorted so the checks run in a stable order; a directory read
  -- gives no such order by itself.
  let dir ← vectorsDir
  let entries ← System.FilePath.readDir dir
  -- `DirEntry.fileName` is a plain `String` in this toolchain, so the
  -- map keeps every entry; nothing is dropped.
  let names := entries.toList.map (·.fileName)
  let jsonNames := names.filter (·.endsWith ".json")
  -- The section title says "every file": a stray non-`.json` entry (a
  -- `.txt`, an uppercase `.JSON`) would sit outside every check below,
  -- so the count equality pins it here.
  r.check s!"every entry of the vector directory is a .json file ({names.length} entries, {jsonNames.length} json)"
    (names.length == jsonNames.length)
  for name in jsonNames.mergeSort (· < ·) do
    -- A parse failure throws and kills the run. That is right here: an
    -- unparseable corpus file is an infrastructure fault, and it fails
    -- loud and early. A missing provenance field is different; it names
    -- one file, so it fails one check (`hasProvenance`).
    let j ← loadJson name
    r.check s!"provenance {name}" (← hasProvenance name j)

  -- W0 moves 50 files; later units grow the corpus. The check name
  -- carries the count, so a drop shows its size.
  r.check s!"corpus size {jsonNames.length} files (at least 50)"
    (jsonNames.length ≥ 50)

  -- Spot shapes: one file per covered area (the multistream framing,
  -- the varint examples, the multiaddr protocol table), each check
  -- naming why the file stands for its area. A regeneration that drops
  -- the data payload fails here before a downstream suite reads the
  -- file.

  -- The multistream-select wire examples. The framing rule is the rule
  -- the future multistream suite decodes against.
  let mssFile := "mss-wire.json"
  let mss ← loadJson mssFile
  r.check s!"{mssFile} framing" (← nonemptyStr mssFile mss "framing")
  r.check s!"{mssFile} cases" (← nonemptyArr mssFile mss "cases")

  -- The unsigned-varint README examples. They seed the varint codec
  -- package.
  let varintFile := "varint-examples.json"
  let varint ← loadJson varintFile
  r.check s!"{varintFile} examples" (← nonemptyArr varintFile varint "examples")

  -- The authoritative multiaddr protocol table. The generated protocol
  -- module of `codec/multiformats` checks itself against it (§3.8).
  let protoFile := "multiaddr-protocols.json"
  let proto ← loadJson protoFile
  r.check s!"{protoFile} protocols" (← nonemptyArr protoFile proto "protocols")

end Tests

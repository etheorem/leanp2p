import LeanP2P
import Lean.Data.Json

/-!
# Shared test-runner support (VECTOR_TEST_PLAN.md phase 0 step 3)

One `Runner` per process. Suites are separate modules that register checks
against it and name the upstream file they mirror.

Check kinds:
- `check`    - must hold; a miss fails the run (exit code 1).
- `skip`     - vector not applicable to this implementation (documented
               divergence with an upstream suite, or a CSV header row);
               counted and printed with the reason, does not fail CI.
-/

namespace Tests

open Lean (Json)
open LeanP2P

structure Runner where
  passed : IO.Ref Nat
  failed : IO.Ref Nat
  todos : IO.Ref Nat
  skipped : IO.Ref Nat
  failures : IO.Ref (List String)

def Runner.new : IO Runner := do
  return {
    passed := ← IO.mkRef 0
    failed := ← IO.mkRef 0
    todos := ← IO.mkRef 0
    skipped := ← IO.mkRef 0
    failures := ← IO.mkRef []
  }

/-- Announce a suite and the upstream file(s) it mirrors. -/
def Runner.section (r : Runner) (_title : String) (upstream : String) : IO Unit := do
  let _ := r
  IO.println s!"-- upstream: {upstream}"

def Runner.check (r : Runner) (name : String) (b : Bool) : IO Unit := do
  if b then
    r.passed.set ((← r.passed.get) + 1)
  else do
    r.failed.set ((← r.failed.get) + 1)
    r.failures.set (name :: (← r.failures.get))
    IO.println s!"FAIL {name}"

/-- Skip a vector with a printed reason (documented upstream divergence or
a non-vector row). Does not fail the run. -/
def Runner.skip (r : Runner) (name : String) (reason : String := "") : IO Unit := do
  r.skipped.set ((← r.skipped.get) + 1)
  IO.println s!"skip {name}"
  if reason != "" then
    IO.println s!"      reason: {reason}"

def Runner.summary (r : Runner) : IO UInt32 := do
  let p ← r.passed.get
  let f ← r.failed.get
  let t ← r.todos.get
  let s ← r.skipped.get
  IO.println ""
  IO.println s!"summary: {p} passed, {f} failed, {t} todo (known gaps), \
      {s} skipped (needs phase 1+ features)"
  if f > 0 then
    IO.println "failures:"
    for n in (← r.failures.get).reverse do
      IO.println s!"  - {n}"
    return 1
  return 0

/-! ## JSON vector loading

Vector files live in `Tests/vectors` (override with `LEANP2P_VECTORS`); each
was generated by `scripts/extract-vectors.py` from the pinned sources in
`VECTORS.lock` and carries its provenance in `_provenance`. -/

def vectorsDir : IO System.FilePath := do
  match ← IO.getEnv "LEANP2P_VECTORS" with
  | some d => pure ⟨d⟩
  | none => pure ⟨"Tests/vectors"⟩

def loadJson (name : String) : IO Json := do
  let path := (← vectorsDir).join ⟨name⟩
  let s ← IO.FS.readFile path
  match Json.parse s with
  | .ok j => pure j
  | .error e => throw <| IO.userError s!"{path}: {e}"

private def asIO (file : String) (e : Except String α) : IO α :=
  match e with
  | .ok a => pure a
  | .error m => throw <| IO.userError s!"{file}: {m}"

def jStr (file : String) (j : Json) (k : String) : IO String := do
  asIO file do
    let v ← j.getObjVal? k
    v.getStr?

def jNat (file : String) (j : Json) (k : String) : IO Nat := do
  asIO file do
    let v ← j.getObjVal? k
    v.getNat?

/-- Optional string field (missing key or null gives `none`). -/
def jStr? (file : String) (j : Json) (k : String) : IO (Option String) := do
  match j.getObjVal? k with
  | .error _ => pure none
  | .ok (.null) => pure none
  | .ok v => some <$> asIO file v.getStr?

def jArr (file : String) (j : Json) (k : String) : IO (List Json) := do
  asIO file do
    let v ← j.getObjVal? k
    return (← v.getArr?).toList

/-- Object field (nested JSON value). -/
def jObj (file : String) (j : Json) (k : String) : IO Json := do
  asIO file do
    j.getObjVal? k

/-- Array of JSON strings. -/
def jStrs (file : String) (j : Json) (k : String) : IO (List String) := do
  let arr ← jArr file j k
  arr.mapM fun v => asIO file v.getStr?

/-- JSON boolean field. -/
def jBool (file : String) (j : Json) (k : String) : IO Bool := do
  asIO file do
    let v ← j.getObjVal? k
    v.getBool?

/-- A `knownDivergence` annotation on a vector entry, if any: the entry
exercises behaviour where two upstream implementations disagree, we follow
one of them and skip the vector with the printed reason. -/
def knownDivergence? (file : String) (j : Json) : IO (Option String) :=
  jStr? file j "knownDivergence"

/-- Decode a hex vector into the `List Nat` byte model. -/
def hexBytes (h : String) : IO (List Nat) := do
  match Bytes.ofHex? h with
  | some b => pure (Bytes.toNatList b)
  | none => throw <| IO.userError s!"bad hex vector {h}"

/-- Decode a hex vector into a `ByteArray`. -/
def hexBytesByteArray (h : String) : IO ByteArray := do
  match Bytes.ofHex? h with
  | some b => pure b
  | none => throw <| IO.userError s!"bad hex vector {h}"

end Tests

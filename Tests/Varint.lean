import Tests.Support
import Varint

/-!
# Unsigned-varint suite

Mirrors `multiformats/unsigned-varint` README (spec examples and rules),
pinned in `VECTORS.lock`, and verifies every milestone of
`packages/codec/varint/docs/PLAN.md` unit 1:

- Fixed table for 0, 1, 127, 128, and 300 in both the `List Nat` model
  and `ByteArray` forms, plus the 63-bit maximum and boundary values.
- The extracted vector corpus in `Tests/vectors/varint-examples.json`,
  covering 1, 127, 128, 255, 300, 16384, and the recorded non-minimal
  counterexample `0x81 0x00`.
- Non-minimal encodings (`0x80 0x00`, `0x81 0x00`, and longer trailing
  zero groups) rejected as `malformed`.
- Over-long inputs (a 10-byte prefix and a 9-continuation-byte prefix)
  rejected as `malformed`.
- Cut prefixes (`[]`, `[0x80]`, and 1 to 8 continuation bytes) reported
  as `truncated`.
- Generic round-trip check (`checkRoundTrips`) over generated `UVarint`
  values across the 63-bit budget.
- Production `ByteArray` path pinned to the `List Nat` model over
  generated byte sequences (`checkModelPins` and direct agreement on
  value, error kind, and consumed length).
-/

set_option autoImplicit false

namespace Tests

open Lean (Json)
open _root_.Varint
open _root_.Varint.Mock

/-- Compare two `Except` values when both error and success types carry `BEq`. -/
private def exceptEq {ε α : Type} [BEq ε] [BEq α] (x y : Except ε α) : Bool :=
  match x, y with
  | .ok a, .ok b => a == b
  | .error e1, .error e2 => e1 == e2
  | _, _ => false

/-- Parse one lowercase or uppercase hexadecimal character into its nibble value. -/
private def hexNibble? (c : Char) : Option Nat :=
  if '0' ≤ c ∧ c ≤ '9' then some (c.toNat - '0'.toNat)
  else if 'a' ≤ c ∧ c ≤ 'f' then some (c.toNat - 'a'.toNat + 10)
  else if 'A' ≤ c ∧ c ≤ 'F' then some (c.toNat - 'A'.toNat + 10)
  else none

/-- Parse pairs of hexadecimal characters into the `List Nat` byte model. -/
private def decodeHexList? : List Char → Option (List Nat)
  | [] => some []
  | [_] => none
  | hi :: lo :: rest =>
    match hexNibble? hi, hexNibble? lo, decodeHexList? rest with
    | some h, some l, some bs => some ((h * 16 + l) :: bs)
    | _, _, _ => none

/-- Decode a hexadecimal vector string into the `List Nat` byte model. -/
private def hexBytes (h : String) : IO (List Nat) := do
  match decodeHexList? h.toList with
  | some bs => pure bs
  | none => throw <| IO.userError s!"bad hex vector {h}"

/-- Construct a `UVarint` from a natural number, masking into the 63-bit budget. -/
private def mkSampleUVarint (n : Nat) : UVarint :=
  let bounded := n % (2 ^ 63)
  have hlt : bounded < 2 ^ 63 := Nat.mod_lt n (by decide)
  ⟨bounded, hlt⟩

/-- Deterministic sample of `UVarint` values spanning 1-byte through 9-byte boundaries. -/
private def generatedUVarints : List UVarint :=
  let boundaryNats : List Nat :=
    [ 0, 1, 2, 63, 64, 126, 127, 128, 129, 254, 255, 256, 273, 300, 421, 443, 460,
      16383, 16384, 16385,
      2097151, 2097152,
      268435455, 268435456,
      34359738367, 34359738368,
      4294967295, 4294967296,
      4398046511103, 4398046511104,
      562949953421311, 562949953421312,
      9007199254740991,
      72057594037927935, 72057594037927936,
      9223372036854775806, 9223372036854775807 ]
  let pseudoRandomNats : List Nat :=
    (List.range 256).map fun seed =>
      let shift := (seed * 7) % 63
      ((1 <<< shift) + seed * 6364136223846793005 + 1442695040888963407) % (2 ^ 63)
  (boundaryNats ++ pseudoRandomNats).map mkSampleUVarint

/-- Deterministic byte sequences covering valid encodings with suffixes,
cut prefixes, non-minimal encodings, over-long prefixes, and pseudo-random bytes. -/
private def generatedByteLists : List (List Nat) :=
  let validWithSuffixes : List (List Nat) :=
    generatedUVarints.map fun v =>
      encode v ++ [v.val % 256, (v.val / 3) % 256]
  let truncatedPrefixes : List (List Nat) :=
    [ [] ] ++
    ((List.range 8).map fun k => List.replicate (k + 1) 0x80) ++
    ((List.range 8).map fun k => List.replicate (k + 1) 0xff)
  let nonMinimalInputs : List (List Nat) :=
    ((List.range 8).map fun k => List.replicate (k + 1) 0x80 ++ [0x00]) ++
    ((List.range 8).map fun k => List.replicate (k + 1) 0x81 ++ [0x00]) ++
    ((List.range 8).map fun k => List.replicate (k + 1) 0xff ++ [0x00, 0x05])
  let overLongInputs : List (List Nat) :=
    [ List.replicate 9 0x80,
      List.replicate 9 0xff,
      List.replicate 9 0x80 ++ [0x01],
      List.replicate 9 0xff ++ [0x01],
      List.replicate 9 0xff ++ [0x7f],
      List.replicate 10 0x80,
      List.replicate 12 0xff ]
  let pseudoRandomBytes : List (List Nat) :=
    (List.range 512).map fun seed =>
      let len := seed % 14
      (List.range len).map fun i =>
        let raw := (seed * 131 + i * 73 + 19) % 256
        if i + 1 < len ∧ (seed + i) % 3 != 0 then raw ||| 0x80 else raw
  validWithSuffixes ++ truncatedPrefixes ++ nonMinimalInputs ++ overLongInputs ++ pseudoRandomBytes

/-- Check whether `decodeB? b` agrees with `decode? (toNatList b)` on the
decoded value, the error kind, and the consumed byte count. -/
private def byteDecisionMatchesModel (b : ByteArray) : Bool :=
  let modelList := toNatList b
  match decodeB? b, decode? modelList with
  | .ok (vb, consumed), .ok (vm, rest) =>
    vb == vm && consumed + rest.length == modelList.length && rest == modelList.drop consumed
  | .error eb, .error em =>
    eb == em
  | _, _ => false

/-- Run the unsigned-varint conformance and property suite. -/
def Varint.run (r : Runner) : IO Unit := do
  r.section "varint" "multiformats/unsigned-varint README.md (examples + rules)"

  -- Milestone 1: Fixed spec table for 0, 1, 127, 128, and 300 in model and ByteArray forms.
  let fixedTable : List (Nat × List Nat) :=
    [ (0, [0x00]),
      (1, [0x01]),
      (127, [0x7f]),
      (128, [0x80, 0x01]),
      (300, [0xac, 0x02]),
      (273, [0x91, 0x02]),
      (0x7fffffffffffffff, List.replicate 8 0xff ++ [0x7f]) ]
  for (n, expectedBytes) in fixedTable do
    let v := mkSampleUVarint n
    let expectedBA := ofNatList expectedBytes
    r.check s!"varint fixed table ofNat? {n}" (UVarint.ofNat? n == some v)
    r.check s!"varint fixed table model encode {n}" (encode v == expectedBytes)
    r.check s!"varint fixed table model decode {n}"
      (exceptEq (decode? expectedBytes) (.ok (v, [])))
    r.check s!"varint fixed table model decode with suffix {n}"
      (exceptEq (decode? (expectedBytes ++ [0x42, 0x99])) (.ok (v, [0x42, 0x99])))
    r.check s!"varint fixed table ByteArray encodeB {n}" (encodeB v == expectedBA)
    r.check s!"varint fixed table ByteArray decodeB? {n}"
      (exceptEq (decodeB? expectedBA) (.ok (v, expectedBytes.length)))
    r.check s!"varint fixed table ByteArray decodeB? with suffix {n}"
      (exceptEq (decodeB? (ofNatList (expectedBytes ++ [0x42, 0x99]))) (.ok (v, expectedBytes.length)))

  -- Upstream vector corpus: Tests/vectors/varint-examples.json.
  let file := "varint-examples.json"
  let j ← loadJson file
  for e in (← jArr file j "examples") do
    let n ← jNat file e "n"
    let hex ← jStr file e "uvarintHex"
    let bs ← hexBytes hex
    let v := mkSampleUVarint n
    r.check s!"varint vector ofNat? {n}" (UVarint.ofNat? n == some v)
    r.check s!"varint vector model encode {n}" (encode v == bs)
    r.check s!"varint vector model decode {n}" (exceptEq (decode? bs) (.ok (v, [])))
    r.check s!"varint vector ByteArray encodeB {n}" (encodeB v == ofNatList bs)
    r.check s!"varint vector ByteArray decodeB? {n}"
      (exceptEq (decodeB? (ofNatList bs)) (.ok (v, bs.length)))

  -- Upstream rules array in varint-examples.json (minimal encoding counterexample 0x81 0x00).
  let rules ← jArr file j "rules"
  for ruleObj in rules do
    match ← jStr? file ruleObj "counterExampleHex" with
    | some counterHex =>
      let badBs ← hexBytes counterHex
      r.check s!"varint vector rule rejects non-minimal {counterHex} in model"
        (exceptEq (decode? badBs) (.error .malformed))
      r.check s!"varint vector rule rejects non-minimal {counterHex} in ByteArray"
        (exceptEq (decodeB? (ofNatList badBs)) (.error .malformed))
    | none => pure ()

  -- Milestone 2: Non-minimal forms are rejected as malformed.
  r.check "varint rejects non-minimal 0x80 0x00 (zero) as malformed in model"
    (exceptEq (decode? [0x80, 0x00]) (.error .malformed))
  r.check "varint rejects non-minimal 0x80 0x00 (zero) as malformed in ByteArray"
    (exceptEq (decodeB? (ofNatList [0x80, 0x00])) (.error .malformed))
  r.check "varint rejects non-minimal 0x81 0x00 (one) as malformed in model"
    (exceptEq (decode? [0x81, 0x00]) (.error .malformed))
  r.check "varint rejects non-minimal 0x81 0x00 (one) as malformed in ByteArray"
    (exceptEq (decodeB? (ofNatList [0x81, 0x00])) (.error .malformed))
  r.check "varint rejects 3-byte non-minimal 0x80 0x80 0x00 as malformed"
    (exceptEq (decode? [0x80, 0x80, 0x00]) (.error .malformed))
  r.check "varint rejects 9-byte non-minimal prefix as malformed"
    (exceptEq (decode? (List.replicate 8 0xff ++ [0x00])) (.error .malformed))

  -- Milestone 3: Over-long varints (reaching or exceeding the 9-byte budget) report malformed.
  let tenBytes := List.replicate 9 0xff ++ [0x01]
  r.check "varint rejects 10-byte prefix as malformed in model"
    (exceptEq (decode? tenBytes) (.error .malformed))
  r.check "varint rejects 10-byte prefix as malformed in ByteArray"
    (exceptEq (decodeB? (ofNatList tenBytes)) (.error .malformed))
  r.check "varint rejects 9 continuation bytes as malformed in model"
    (exceptEq (decode? (List.replicate 9 0x80)) (.error .malformed))
  r.check "varint rejects 9 continuation bytes as malformed in ByteArray"
    (exceptEq (decodeB? (ofNatList (List.replicate 9 0x80))) (.error .malformed))
  r.check "varint rejects 2^63 at UVarint.ofNat? boundary"
    (UVarint.ofNat? (2 ^ 63) == none)
  r.check "varint rejects 2^63 wire encoding as malformed"
    (exceptEq (decode? (encodeNat (2 ^ 63))) (.error .malformed))
  r.check "varint rejects model value >= 256 as malformed"
    (exceptEq (decode? [256]) (.error .malformed))

  -- Milestone 4: Cut prefixes inside the budget report truncated.
  r.check "varint reports empty input as truncated in model"
    (exceptEq (decode? []) (.error .truncated))
  r.check "varint reports empty input as truncated in ByteArray"
    (exceptEq (decodeB? ByteArray.empty) (.error .truncated))
  r.check "varint reports cut prefix 0x80 as truncated in model"
    (exceptEq (decode? [0x80]) (.error .truncated))
  r.check "varint reports cut prefix 0x80 as truncated in ByteArray"
    (exceptEq (decodeB? (ofNatList [0x80])) (.error .truncated))
  for k in [1, 2, 3, 4, 5, 6, 7, 8] do
    let cut := List.replicate k 0x80
    r.check s!"varint reports {k}-byte continuation prefix as truncated in model"
      (exceptEq (decode? cut) (.error .truncated))
    r.check s!"varint reports {k}-byte continuation prefix as truncated in ByteArray"
      (exceptEq (decodeB? (ofNatList cut)) (.error .truncated))

  -- Milestone 6: Generic round-trip harness of base/bytes run once for UVarint.
  r.check "varint generic round-trip harness (checkRoundTrips)"
    (checkRoundTrips generatedUVarints)

  -- Milestone 5: Production ByteArray path pinned to the model over generated inputs.
  let byteSamples := generatedByteLists.map ofNatList
  r.check "varint generic model pin harness (checkModelPins)"
    (checkModelPins decodeBModelAdapter byteSamples)
  let mut sampleIdx : Nat := 0
  for b in byteSamples do
    r.check s!"varint ByteArray pin matches model on value, error, and length ({sampleIdx})"
      (byteDecisionMatchesModel b)
    sampleIdx := sampleIdx + 1

  -- Offset decoding check on decodeBAt? for framing callers.
  let prefixBytes : List Nat := [0xde, 0xad, 0xbe]
  let target := mkSampleUVarint 16384
  let suffixBytes : List Nat := [0xfe, 0xed]
  let framedBA := ofNatList (prefixBytes ++ encode target ++ suffixBytes)
  r.check "varint decodeBAt? decodes at non-zero offset and reports consumed count"
    (exceptEq (decodeBAt? framedBA prefixBytes.length) (.ok (target, (encode target).length)))

end Tests

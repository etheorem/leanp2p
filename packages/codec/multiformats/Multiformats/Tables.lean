set_option maxRecDepth 4096 in
/-- Every constructor is recovered from its wire code. -/
@[simp] theorem HashCode.ofCodeToCode (value : HashCode) :
    ofCode? value.toCode = some value := by
  cases value <;> rfl

/-- Equal codes identify the same canonical registry member. -/
theorem HashCode.toCodeInjective {a b : HashCode} (h : a.toCode = b.toCode) : a = b := by
  have hi := congrArg HashCode.ofCode? h
  simpa only [HashCode.ofCodeToCode, Option.some.injEq] using hi

set_option maxRecDepth 4096 in
/-- Every registry code fits the shared nine-byte varint budget. -/
theorem HashCode.codeLt (value : HashCode) : value.toCode < 2 ^ 63 := by
  cases value <;> decide

